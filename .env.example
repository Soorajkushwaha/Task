# WHIMSYMAYA — Cloudflare Workers Environment Configuration
# Store production secrets via `npx wrangler secret put <SECRET_NAME>`
# Never commit real secret values to source control.

# Better Auth / Session Signing Secret (Required in production via Wrangler secrets)
BETTER_AUTH_SECRET=

# Cloudflare Turnstile Bot Protection
# Public site key can be passed to the frontend; secret key MUST remain server-side in Worker secrets.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Google OAuth Credentials (Enabled automatically when configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Transactional Email Provider for Password Reset (e.g., Resend API Key)
RESEND_API_KEY=
EMAIL_FROM=
